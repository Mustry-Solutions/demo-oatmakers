        "documentation": "{Description}",
        "formatString": "#,##0.##"
      },
      {
        "name": "LowLimit",
        "tagType": "AtomicTag",
        "valueSource": "memory",
        "dataType": "Float8",
        "engUnit": "{Unit}",
        "value": 0.0
      },
      {
        "name": "HighLimit",
        "tagType": "AtomicTag",
        "valueSource": "memory",
        "dataType": "Float8",
        "engUnit": "{Unit}",
        "value": 100.0
      },
      {
        "name": "Alarm",
        "tagType": "AtomicTag",
        "valueSource": "expr",
        "dataType": "Boolean",
        "expression": "{[.]PV} < {[.]LowLimit} || {[.]PV} > {[.]HighLimit}"
      }
    ]
  },
