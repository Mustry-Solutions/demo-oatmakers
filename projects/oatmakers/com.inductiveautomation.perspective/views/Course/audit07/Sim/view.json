{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 300,
      "width": 500
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Title"
        },
        "position": {
          "basis": "50px"
        },
        "props": {
          "style": {
            "fontSize": 24,
            "fontWeight": "bold"
          },
          "text": "CourseSim live values (audit07)"
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Ramp"
        },
        "position": {
          "basis": "40px"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "'Ramp: ' + numberFormat({[default]Course/Ramp}, '0.00')"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "fontSize": 20
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Sine"
        },
        "position": {
          "basis": "40px"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "'Sine: ' + numberFormat({[default]Course/Sine}, '0.00')"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "fontSize": 20
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "padding": 20
      }
    },
    "type": "ia.container.flex"
  }
}
