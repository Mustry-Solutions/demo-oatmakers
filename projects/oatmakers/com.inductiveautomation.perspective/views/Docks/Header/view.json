{
  "custom": {},
  "params": {},
  "propConfig": {},
  "props": {
    "defaultSize": {
      "width": 1280,
      "height": 40
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "row",
      "style": {
        "classes": "Hmi/HeaderDock"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Where"
        },
        "props": {
          "text": "",
          "style": {
            "classes": "Hmi/HeaderWhere"
          }
        },
        "position": {
          "shrink": 0,
          "basis": "auto",
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "page.props.path"
              },
              "transforms": [
                {
                  "type": "script",
                  "code": "\ttitles = system.util.jsonDecode(\"{\\\"/\\\": \\\"Factory overview\\\", \\\"/demo/health\\\": \\\"Demo health\\\", \\\"/demo/input-fields\\\": \\\"Batch output\\\", \\\"/makeramaigreatagain\\\": \\\"\\\", \\\"/observatory\\\": \\\"Gateway Observatory\\\", \\\"/oee\\\": \\\"Performance\\\", \\\"/operator\\\": \\\"Batch output\\\", \\\"/performance\\\": \\\"Performance\\\", \\\"/process\\\": \\\"SCADA\\\", \\\"/production\\\": \\\"Production planning\\\", \\\"/quality\\\": \\\"Quality & traceability\\\", \\\"/scada\\\": \\\"SCADA\\\", \\\"/settings\\\": \\\"Settings\\\", \\\"/scada/intake\\\": \\\"Intake & raw oat silos\\\", \\\"/scada/cleaning\\\": \\\"Cleaning\\\", \\\"/scada/dehulling\\\": \\\"Dehulling\\\", \\\"/scada/kiln\\\": \\\"Kilning & stabilisation\\\", \\\"/scada/flaking\\\": \\\"Line 01 \\\\u00b7 Steaming & flaking\\\", \\\"/scada/cutting\\\": \\\"Line 02 \\\\u00b7 Groat cutting\\\", \\\"/scada/milling\\\": \\\"Line 03 \\\\u00b7 Oat flour milling\\\", \\\"/scada/packing\\\": \\\"Packing & palletising\\\", \\\"/scada/utilities\\\": \\\"Steam & compressed air\\\"}\")\n\treturn \"OATMAKERS / \" + titles.get(value, \"\").upper()"
                }
              ]
            }
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Labels"
        },
        "props": {
          "direction": "row",
          "style": {
            "classes": "Hmi/LabelToggle"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Caption"
            },
            "props": {
              "text": "Labels",
              "style": {
                "classes": "Demo/Muted"
              }
            },
            "position": {
              "shrink": 0,
              "basis": "auto"
            }
          },
          {
            "type": "ia.input.toggle-switch",
            "meta": {
              "name": "LabelSwitch"
            },
            "props": {
              "selected": true
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.selected": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "session.custom.showLabels",
                    "bidirectional": true
                  }
                }
              }
            }
          }
        ],
        "position": {
          "shrink": 0
        }
      }
    ],
    "position": {
      "shrink": 0
    },
    "propConfig": {
      "props.style.classes": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "if(try({session.custom.theme}, \"\") = \"hello-kitty\", \"Hmi/HeaderDock Theme/HelloKitty\", \"Hmi/HeaderDock\")"
          }
        }
      }
    }
  }
}
