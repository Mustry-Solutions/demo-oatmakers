{
  "custom": {},
  "params": {
    "area": "intake",
    "tag": "M101",
    "signal": "",
    "unit": "",
    "decimals": 1,
    "running": true,
    "on": "",
    "off": "",
    "compact": true
  },
  "propConfig": {
    "params.area": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tag": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.signal": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.unit": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.decimals": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.running": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.on": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.off": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.compact": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 1280,
      "height": 88
    }
  },
  "root": {
    "type": "ia.container.coord",
    "meta": {
      "name": "root"
    },
    "props": {
      "mode": "percent",
      "style": {
        "cursor": "pointer"
      }
    },
    "children": [
      {
        "type": "ia.display.image",
        "meta": {
          "name": "Graphic"
        },
        "props": {
          "source": "",
          "altText": "Equipment",
          "fit": {
            "mode": "fill"
          },
          "style": {
            "pointerEvents": "none"
          }
        },
        "position": {
          "x": 0,
          "y": 0,
          "width": 1,
          "height": 1
        },
        "propConfig": {
          "props.source": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.params.running}, {view.params.on}, {view.params.off})"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Tag"
        },
        "props": {
          "text": "",
          "style": {
            "classes": "Hmi/Tag"
          }
        },
        "position": {
          "x": 0,
          "y": 0,
          "width": 1,
          "height": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.tag"
              }
            }
          },
          "meta.visible": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{session.custom.showLabels}"
              }
            }
          },
          "position.x": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.params.compact}, 0.38, 0)"
              }
            }
          },
          "position.y": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.params.compact}, 0.37, 0.81)"
              }
            }
          },
          "position.width": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.params.compact}, 0.62, 1)"
              }
            }
          },
          "position.height": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.params.compact}, 0.25, 0.17)"
              }
            }
          },
          "props.style.alignItems": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.params.compact}, \"flex-start\", \"center\")"
              }
            }
          }
        }
      }
    ],
    "position": {
      "shrink": 0
    },
    "events": {
      "dom": {
        "onClick": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "\tp = self.view.params\n\tif p.signal:\n\t\tapplication.demo.showScadaDetail(p.area, p.tag, p.signal, p.unit, p.decimals)"
          }
        }
      }
    }
  }
}
