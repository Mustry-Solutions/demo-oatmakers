{
  "custom": {},
  "params": {
    "area": "intake",
    "tag": "",
    "signal": "",
    "unit": "",
    "decimals": 1,
    "tagPath": ""
  },
  "propConfig": {
    "params.area": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tag": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.signal": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.unit": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.decimals": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 520,
      "height": 360
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "Demo/PopupRoot"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Title"
        },
        "props": {
          "text": "",
          "style": {
            "classes": "Demo/SectionTitle"
          }
        },
        "position": {
          "shrink": 0,
          "basis": "auto"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.tag"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Path"
        },
        "props": {
          "text": "",
          "style": {
            "classes": "Demo/Muted"
          }
        },
        "position": {
          "shrink": 0,
          "basis": "auto"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.tagPath"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Mode"
        },
        "props": {
          "text": "Read-only process simulation",
          "style": {
            "classes": "Demo/Muted"
          }
        },
        "position": {
          "shrink": 0,
          "basis": "auto"
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Value"
        },
        "props": {
          "text": "",
          "style": {
            "classes": "Hmi/DetailValue"
          }
        },
        "position": {
          "shrink": 0,
          "basis": "auto"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(len({view.params.tagPath}) > 0, tag({view.params.tagPath}), 0)"
              },
              "transforms": [
                {
                  "type": "script",
                  "code": "\tp = self.view.params\n\treturn application.demo._scadaFormat(value, p.unit, p.decimals)"
                }
              ]
            }
          }
        }
      },
      {
        "type": "ia.display.view",
        "meta": {
          "name": "Trend"
        },
        "props": {
          "path": "Demo/Hmi/Trend",
          "params": {
            "colour": "#626b75",
            "sp": 0
          },
          "useDefaultViewWidth": false,
          "useDefaultViewHeight": false
        },
        "position": {
          "shrink": 0,
          "basis": "160px"
        },
        "propConfig": {
          "props.params.area": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.area"
              }
            }
          },
          "props.params.signal": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.signal"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Caption"
        },
        "props": {
          "text": "",
          "style": {
            "classes": "Demo/Muted"
          }
        },
        "position": {
          "shrink": 0,
          "basis": "auto"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.params.area}"
              },
              "transforms": [
                {
                  "type": "script",
                  "code": "\treturn application.demo.scadaAreaTitle(value) + \" | recent trend\""
                }
              ]
            }
          }
        }
      }
    ],
    "position": {
      "shrink": 0
    },
    "propConfig": {
      "props.style.classes": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "if(try({session.custom.theme}, \"\") = \"hello-kitty\", \"Demo/PopupRoot Theme/HelloKitty\", \"Demo/PopupRoot\")"
          }
        }
      }
    }
  }
}
