{
  "custom": {},
  "params": {
    "area": "intake",
    "route": "/scada/intake"
  },
  "propConfig": {
    "params.area": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.route": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 1280,
      "height": 170
    }
  },
  "root": {
    "type": "ia.container.coord",
    "meta": {
      "name": "root"
    },
    "props": {
      "mode": "percent",
      "style": {
        "cursor": "pointer"
      }
    },
    "children": [
      {
        "type": "ia.display.image",
        "meta": {
          "name": "Graphic"
        },
        "props": {
          "source": "",
          "altText": "Process area",
          "fit": {
            "mode": "fill"
          },
          "style": {
            "pointerEvents": "none"
          }
        },
        "position": {
          "x": 0,
          "y": 0,
          "width": 1,
          "height": 1
        },
        "propConfig": {
          "props.source": {
            "binding": {
              "type": "expr-struct",
              "config": {
                "waitOnAll": true,
                "struct": {
                  "tick": "now(2000)",
                  "area": "{view.params.area}"
                }
              },
              "transforms": [
                {
                  "type": "script",
                  "code": "\treturn application.demo.scadaTileSvg(value[\"area\"])"
                }
              ]
            }
          }
        }
      }
    ],
    "position": {
      "shrink": 0
    },
    "events": {
      "dom": {
        "onClick": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "\tsystem.perspective.navigate(self.view.params.route)"
          }
        }
      }
    }
  }
}
