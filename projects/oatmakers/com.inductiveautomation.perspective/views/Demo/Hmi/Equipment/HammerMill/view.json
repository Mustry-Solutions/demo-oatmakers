{
  "custom": {},
  "params": {
    "tag": "",
    "width": 100,
    "height": 100
  },
  "propConfig": {
    "params.tag": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.width": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.height": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 1280,
      "height": 100
    }
  },
  "root": {
    "type": "ia.container.coord",
    "meta": {
      "name": "root"
    },
    "props": {
      "mode": "percent"
    },
    "children": [
      {
        "type": "ia.display.image",
        "meta": {
          "name": "Shape"
        },
        "props": {
          "source": "",
          "altText": "HammerMill",
          "fit": {
            "mode": "fill"
          },
          "style": {
            "pointerEvents": "none"
          }
        },
        "position": {
          "x": 0,
          "y": 0,
          "width": 1,
          "height": 1
        },
        "propConfig": {
          "props.source": {
            "binding": {
              "type": "expr-struct",
              "config": {
                "waitOnAll": true,
                "struct": {
                  "width": "{view.params.width}",
                  "height": "{view.params.height}"
                }
              },
              "transforms": [
                {
                  "type": "script",
                  "code": "\tw, h = float(value[\"width\"]), float(value[\"height\"])\n\tcx, cy = w/2, h/2\n\tbody = '<rect width=\"%s\" height=\"%s\" rx=\"6\"/><circle cx=\"%s\" cy=\"%s\" r=\"%s\" fill=\"#c9cbca\"/>' % (w, h, cx, cy, h*0.32)\n\tbody += ''.join('<rect x=\"%s\" y=\"%s\" width=\"8\" height=\"%s\" transform=\"rotate(%d %s %s)\" fill=\"#999\"/>' % (cx-4, cy-h*0.3, h*0.14, a, cx, cy) for a in range(0, 360, 60))\n\treturn application.demo.scadaEquipmentSvg(body, w, h, [0, 0, 0, 0])"
                }
              ]
            }
          },
          "props.altText": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(len({view.params.tag}) > 0, {view.params.tag}, \"HammerMill\")"
              }
            }
          }
        }
      }
    ],
    "position": {
      "shrink": 0
    }
  }
}
