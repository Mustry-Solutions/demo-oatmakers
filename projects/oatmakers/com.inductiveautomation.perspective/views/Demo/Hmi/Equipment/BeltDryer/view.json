{
  "custom": {},
  "params": {
    "tag": "",
    "width": 100,
    "height": 100
  },
  "propConfig": {
    "params.tag": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.width": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.height": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 1280,
      "height": 100
    }
  },
  "root": {
    "type": "ia.container.coord",
    "meta": {
      "name": "root"
    },
    "props": {
      "mode": "percent"
    },
    "children": [
      {
        "type": "ia.display.image",
        "meta": {
          "name": "Shape"
        },
        "props": {
          "source": "",
          "altText": "BeltDryer",
          "fit": {
            "mode": "fill"
          },
          "style": {
            "pointerEvents": "none"
          }
        },
        "position": {
          "x": 0,
          "y": 0,
          "width": 1,
          "height": 1
        },
        "propConfig": {
          "props.source": {
            "binding": {
              "type": "expr-struct",
              "config": {
                "waitOnAll": true,
                "struct": {
                  "width": "{view.params.width}",
                  "height": "{view.params.height}"
                }
              },
              "transforms": [
                {
                  "type": "script",
                  "code": "\tw, h = float(value[\"width\"]), float(value[\"height\"])\n\tbody = '<rect width=\"%s\" height=\"%s\" rx=\"4\"/>' % (w, h) + ''.join('<path d=\"M12 %s H%s\" fill=\"none\" stroke-width=\"2\"/>' % (h*f, w-12) for f in (0.3, 0.55, 0.8))\n\tbody += ''.join('<path d=\"M%s 0 v-12 h24 v12\" fill=\"none\"/>' % (w*f) for f in (0.2, 0.5, 0.8))\n\treturn application.demo.scadaEquipmentSvg(body, w, h, [0, 12, 0, 0])"
                }
              ]
            }
          },
          "props.altText": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(len({view.params.tag}) > 0, {view.params.tag}, \"BeltDryer\")"
              }
            }
          }
        }
      }
    ],
    "position": {
      "shrink": 0
    }
  }
}
