{
  "custom": {},
  "params": {
    "tag": "DS201",
    "title": "Destoner",
    "width": 200,
    "height": 110,
    "labelX": 100.0,
    "labelY": 128
  },
  "propConfig": {
    "params.tag": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.title": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.width": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.height": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.labelX": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.labelY": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 204,
      "height": 114
    }
  },
  "root": {
    "type": "ia.container.coord",
    "meta": {
      "name": "root"
    },
    "props": {
      "mode": "fixed",
      "style": {
        "overflow": "visible"
      }
    },
    "children": [
      {
        "type": "ia.display.image",
        "meta": {
          "name": "Shape"
        },
        "props": {
          "source": "",
          "altText": "Destoner",
          "fit": {
            "mode": "fill"
          },
          "style": {
            "pointerEvents": "none"
          }
        },
        "position": {
          "x": 0,
          "y": 0,
          "width": 100,
          "height": 100
        },
        "propConfig": {
          "props.source": {
            "binding": {
              "type": "expr-struct",
              "config": {
                "waitOnAll": true,
                "struct": {
                  "width": "{view.params.width}",
                  "height": "{view.params.height}"
                }
              },
              "transforms": [
                {
                  "type": "script",
                  "code": "\tw, h = float(value[\"width\"]), float(value[\"height\"])\n\tbody = '<path d=\"M0 %s L%s 0 V%s L0 %s Z\"/><path d=\"M20 %s V%s M%s %s V%s M12 %s h16 M%s %s h16\" fill=\"none\"/>' % (h*0.2, w, h*0.45, h*0.65, h*0.62, h, w-20, h*0.42, h, h, w-28, h)\n\treturn application.demo.scadaEquipmentSvg(body, w, h, [0, 0, 0, 0])"
                }
              ]
            }
          },
          "props.altText": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(len({view.params.tag}) > 0, {view.params.tag}, \"Destoner\")"
              }
            }
          },
          "position.width": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.params.width} + 4"
              }
            }
          },
          "position.height": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.params.height} + 4"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Tag"
        },
        "props": {
          "text": "",
          "style": {
            "classes": "Hmi/Text Hmi/Tag"
          }
        },
        "position": {
          "x": 0,
          "y": 0,
          "width": 300,
          "height": 16
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.tag"
              }
            }
          },
          "meta.visible": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{session.custom.showLabels} && len({view.params.tag}) > 0"
              }
            }
          },
          "position.x": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.params.labelX} + -148"
              }
            }
          },
          "position.y": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.params.labelY} + -10"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Title"
        },
        "props": {
          "text": "",
          "style": {
            "classes": "Hmi/Text Hmi/Title"
          }
        },
        "position": {
          "x": 0,
          "y": 0,
          "width": 300,
          "height": 14
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.title"
              }
            }
          },
          "meta.visible": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{session.custom.showLabels} && len({view.params.title}) > 0"
              }
            }
          },
          "position.x": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.params.labelX} + -148"
              }
            }
          },
          "position.y": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.params.labelY} + 6"
              }
            }
          }
        }
      }
    ]
  }
}
