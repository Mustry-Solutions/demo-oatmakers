{
  "custom": {},
  "params": {
    "tag": "CL501",
    "title": "Flake cooler",
    "width": 150,
    "height": 150,
    "labelX": 75.0,
    "labelY": 168
  },
  "propConfig": {
    "params.tag": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.title": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.width": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.height": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.labelX": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.labelY": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 154,
      "height": 154
    }
  },
  "root": {
    "type": "ia.container.coord",
    "meta": {
      "name": "root"
    },
    "props": {
      "mode": "fixed",
      "style": {
        "overflow": "visible"
      }
    },
    "children": [
      {
        "type": "ia.display.image",
        "meta": {
          "name": "Shape"
        },
        "props": {
          "source": "",
          "altText": "Cooler",
          "fit": {
            "mode": "fill"
          },
          "style": {
            "pointerEvents": "none"
          }
        },
        "position": {
          "x": 0,
          "y": 0,
          "width": 100,
          "height": 100
        },
        "propConfig": {
          "props.source": {
            "binding": {
              "type": "expr-struct",
              "config": {
                "waitOnAll": true,
                "struct": {
                  "width": "{view.params.width}",
                  "height": "{view.params.height}"
                }
              },
              "transforms": [
                {
                  "type": "script",
                  "code": "\tw, h = float(value[\"width\"]), float(value[\"height\"])\n\tbody = '<rect width=\"%s\" height=\"%s\" rx=\"4\"/>' % (w, h) + ''.join('<path d=\"M%s %s l14 -10\" fill=\"none\" stroke-width=\"1\"/>' % (12+i*22, h*f) for f in (0.3, 0.55, 0.8) for i in range(int((w-30)/22)))\n\treturn application.demo.scadaEquipmentSvg(body, w, h, [0, 0, 0, 0])"
                }
              ]
            }
          },
          "props.altText": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(len({view.params.tag}) > 0, {view.params.tag}, \"Cooler\")"
              }
            }
          },
          "position.width": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.params.width} + 4"
              }
            }
          },
          "position.height": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.params.height} + 4"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Tag"
        },
        "props": {
          "text": "",
          "style": {
            "classes": "Hmi/Text Hmi/Tag"
          }
        },
        "position": {
          "x": 0,
          "y": 0,
          "width": 300,
          "height": 16
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.tag"
              }
            }
          },
          "meta.visible": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{session.custom.showLabels} && len({view.params.tag}) > 0"
              }
            }
          },
          "position.x": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.params.labelX} + -148"
              }
            }
          },
          "position.y": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.params.labelY} + -10"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Title"
        },
        "props": {
          "text": "",
          "style": {
            "classes": "Hmi/Text Hmi/Title"
          }
        },
        "position": {
          "x": 0,
          "y": 0,
          "width": 300,
          "height": 14
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.title"
              }
            }
          },
          "meta.visible": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{session.custom.showLabels} && len({view.params.title}) > 0"
              }
            }
          },
          "position.x": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.params.labelX} + -148"
              }
            }
          },
          "position.y": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.params.labelY} + 6"
              }
            }
          }
        }
      }
    ]
  }
}
