{
  "custom": {},
  "params": {
    "tag": "KL401",
    "title": "Kiln",
    "width": 140,
    "height": 330,
    "labelX": 70.0,
    "labelY": 122.1
  },
  "propConfig": {
    "params.tag": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.title": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.width": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.height": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.labelX": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.labelY": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 144,
      "height": 348
    }
  },
  "root": {
    "type": "ia.container.coord",
    "meta": {
      "name": "root"
    },
    "props": {
      "mode": "fixed",
      "style": {
        "overflow": "visible"
      }
    },
    "children": [
      {
        "type": "ia.display.image",
        "meta": {
          "name": "Shape"
        },
        "props": {
          "source": "",
          "altText": "Kiln",
          "fit": {
            "mode": "fill"
          },
          "style": {
            "pointerEvents": "none"
          }
        },
        "position": {
          "x": 0,
          "y": 0,
          "width": 100,
          "height": 100
        },
        "propConfig": {
          "props.source": {
            "binding": {
              "type": "expr-struct",
              "config": {
                "waitOnAll": true,
                "struct": {
                  "width": "{view.params.width}",
                  "height": "{view.params.height}"
                }
              },
              "transforms": [
                {
                  "type": "script",
                  "code": "\tw, h = float(value[\"width\"]), float(value[\"height\"])\n\tbody = '<path d=\"M0 20 Q%s -14 %s 20 V%s L%s %s H%s L0 %s Z\"/>' % (w/2, w, h-40, w/2+12, h, w/2-12, h-40)\n\tbody += ''.join('<path d=\"M3 %s h%s\" fill=\"none\" stroke=\"#c9a54e\" stroke-width=\"2.5\"/>' % (h*f, w-6) for f in (0.3, 0.5, 0.7))\n\treturn application.demo.scadaEquipmentSvg(body, w, h, [0, 14, 0, 0])"
                }
              ]
            }
          },
          "props.altText": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(len({view.params.tag}) > 0, {view.params.tag}, \"Kiln\")"
              }
            }
          },
          "position.width": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.params.width} + 4"
              }
            }
          },
          "position.height": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.params.height} + 18"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Tag"
        },
        "props": {
          "text": "",
          "style": {
            "classes": "Hmi/Text Hmi/Tag"
          }
        },
        "position": {
          "x": 0,
          "y": 0,
          "width": 300,
          "height": 16
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.tag"
              }
            }
          },
          "meta.visible": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{session.custom.showLabels} && len({view.params.tag}) > 0"
              }
            }
          },
          "position.x": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.params.labelX} + -148"
              }
            }
          },
          "position.y": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.params.labelY} + 4"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Title"
        },
        "props": {
          "text": "",
          "style": {
            "classes": "Hmi/Text Hmi/Title"
          }
        },
        "position": {
          "x": 0,
          "y": 0,
          "width": 300,
          "height": 14
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.title"
              }
            }
          },
          "meta.visible": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{session.custom.showLabels} && len({view.params.title}) > 0"
              }
            }
          },
          "position.x": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.params.labelX} + -148"
              }
            }
          },
          "position.y": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.params.labelY} + 20"
              }
            }
          }
        }
      }
    ]
  }
}
