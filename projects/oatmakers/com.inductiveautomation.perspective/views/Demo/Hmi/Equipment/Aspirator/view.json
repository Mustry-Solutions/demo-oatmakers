{
  "custom": {},
  "params": {
    "tag": "AS201",
    "title": "Aspirator",
    "width": 130,
    "height": 170,
    "labelX": 65.0,
    "labelY": 188
  },
  "propConfig": {
    "params.tag": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.title": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.width": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.height": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.labelX": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.labelY": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 134,
      "height": 174
    }
  },
  "root": {
    "type": "ia.container.coord",
    "meta": {
      "name": "root"
    },
    "props": {
      "mode": "fixed",
      "style": {
        "overflow": "visible"
      }
    },
    "children": [
      {
        "type": "ia.display.image",
        "meta": {
          "name": "Shape"
        },
        "props": {
          "source": "",
          "altText": "Aspirator",
          "fit": {
            "mode": "fill"
          },
          "style": {
            "pointerEvents": "none"
          }
        },
        "position": {
          "x": 0,
          "y": 0,
          "width": 100,
          "height": 100
        },
        "propConfig": {
          "props.source": {
            "binding": {
              "type": "expr-struct",
              "config": {
                "waitOnAll": true,
                "struct": {
                  "width": "{view.params.width}",
                  "height": "{view.params.height}"
                }
              },
              "transforms": [
                {
                  "type": "script",
                  "code": "\tw, h = float(value[\"width\"]), float(value[\"height\"])\n\ts = w * 0.4\n\tbody = '<rect width=\"%s\" height=\"%s\" rx=\"4\"/><path d=\"M%s %s l%s 20 l-%s 20 l%s 20 l-%s 20\" fill=\"none\" stroke-width=\"1\"/>' % (w, h, w*0.3, h*0.3, s, s, s, s)\n\tbody += '<path d=\"M%s %s v-36 m-6 8 l6 -8 l6 8\" fill=\"none\" stroke-width=\"1.2\"/>' % (w*0.75, h*0.55)\n\treturn application.demo.scadaEquipmentSvg(body, w, h, [0, 0, 0, 0])"
                }
              ]
            }
          },
          "props.altText": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(len({view.params.tag}) > 0, {view.params.tag}, \"Aspirator\")"
              }
            }
          },
          "position.width": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.params.width} + 4"
              }
            }
          },
          "position.height": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.params.height} + 4"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Tag"
        },
        "props": {
          "text": "",
          "style": {
            "classes": "Hmi/Text Hmi/Tag"
          }
        },
        "position": {
          "x": 0,
          "y": 0,
          "width": 300,
          "height": 16
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.tag"
              }
            }
          },
          "meta.visible": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{session.custom.showLabels} && len({view.params.tag}) > 0"
              }
            }
          },
          "position.x": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.params.labelX} + -148"
              }
            }
          },
          "position.y": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.params.labelY} + -10"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Title"
        },
        "props": {
          "text": "",
          "style": {
            "classes": "Hmi/Text Hmi/Title"
          }
        },
        "position": {
          "x": 0,
          "y": 0,
          "width": 300,
          "height": 14
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.title"
              }
            }
          },
          "meta.visible": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{session.custom.showLabels} && len({view.params.title}) > 0"
              }
            }
          },
          "position.x": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.params.labelX} + -148"
              }
            }
          },
          "position.y": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.params.labelY} + 6"
              }
            }
          }
        }
      }
    ]
  }
}
