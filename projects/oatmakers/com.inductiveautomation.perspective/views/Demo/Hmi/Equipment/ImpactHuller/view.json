{
  "custom": {},
  "params": {
    "tag": "",
    "width": 100,
    "height": 100
  },
  "propConfig": {
    "params.tag": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.width": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.height": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 1280,
      "height": 100
    }
  },
  "root": {
    "type": "ia.container.coord",
    "meta": {
      "name": "root"
    },
    "props": {
      "mode": "percent"
    },
    "children": [
      {
        "type": "ia.display.image",
        "meta": {
          "name": "Shape"
        },
        "props": {
          "source": "",
          "altText": "ImpactHuller",
          "fit": {
            "mode": "fill"
          },
          "style": {
            "pointerEvents": "none"
          }
        },
        "position": {
          "x": 0,
          "y": 0,
          "width": 1,
          "height": 1
        },
        "propConfig": {
          "props.source": {
            "binding": {
              "type": "expr-struct",
              "config": {
                "waitOnAll": true,
                "struct": {
                  "width": "{view.params.width}",
                  "height": "{view.params.height}"
                }
              },
              "transforms": [
                {
                  "type": "script",
                  "code": "\tw, h = float(value[\"width\"]), float(value[\"height\"])\n\tr = w / 2\n\tbody = '<path d=\"M%s -18 h40 l-8 18 h-24 Z\"/><circle cx=\"%s\" cy=\"%s\" r=\"%s\"/><circle cx=\"%s\" cy=\"%s\" r=\"%s\" fill=\"#c9cbca\"/>' % (r-20, r, r, r, r, r, r*0.55)\n\tbody += ''.join('<path d=\"M%s %s l%s 0\" transform=\"rotate(%d %s %s)\" fill=\"none\" stroke-width=\"3\"/>' % (r, r, r*0.55, a, r, r) for a in range(0, 360, 45))\n\treturn application.demo.scadaEquipmentSvg(body, w, h, [0, 18, 0, 0])"
                }
              ]
            }
          },
          "props.altText": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(len({view.params.tag}) > 0, {view.params.tag}, \"ImpactHuller\")"
              }
            }
          }
        }
      }
    ],
    "position": {
      "shrink": 0
    }
  }
}
