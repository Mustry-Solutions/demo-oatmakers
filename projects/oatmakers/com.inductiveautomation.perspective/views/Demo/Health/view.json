{
  "custom": {},
  "params": {},
  "propConfig": {
    "custom.health": {
      "binding": {
        "config": {
          "struct": {
            "refresh": "now(5000)"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\treturn application.demo.health()",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.live": {
      "binding": {
        "config": {
          "struct": {
            "tick": "now(1000)"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\treturn application.demo.live()",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 1000,
      "width": 1280
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "children": [
              {
                "meta": {
                  "name": "Eyebrow"
                },
                "position": {
                  "shrink": 0
                },
                "props": {
                  "style": {
                    "classes": "Demo/Eyebrow"
                  },
                  "text": "OATMAKERS / LIVE OPERATIONS"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "Title"
                },
                "position": {
                  "shrink": 0
                },
                "props": {
                  "style": {
                    "classes": "Demo/PageTitle"
                  },
                  "text": "Demo health"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "Subtitle"
                },
                "position": {
                  "shrink": 0
                },
                "props": {
                  "style": {
                    "classes": "Demo/Subtitle"
                  },
                  "text": "Data freshness and automatic retention."
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "Identity"
            },
            "position": {
              "grow": 1,
              "shrink": 0
            },
            "props": {
              "direction": "column"
            },
            "type": "ia.container.flex"
          },
          {
            "meta": {
              "name": "Mode"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "Demo/DemoBadge"
              },
              "text": "SIMULATED FACTORY"
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "Header"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "Demo/PageHeader"
          },
          "wrap": "wrap"
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "LiveStatus"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.style.color": {
            "binding": {
              "config": {
                "expression": "if({view.custom.live.ready}, \"#6d757c\", \"#b57a17\")"
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "expression": "if({view.custom.live.ready}, \"Live · recorded at \" + {view.custom.live.updatedAt} + \" · updates every second\", \"Live telemetry is unavailable\")"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "classes": "Demo/LiveStatus"
          }
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Age"
            },
            "position": {
              "basis": "240px",
              "grow": 1,
              "shrink": 0
            },
            "propConfig": {
              "props.params.value": {
                "binding": {
                  "config": {
                    "path": "view.custom.health.liveAgeSeconds"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "params": {
                "hint": "One-second recorded telemetry",
                "title": "LIVE DATA AGE",
                "unit": "sec"
              },
              "path": "Demo/Components/Metric"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "History"
            },
            "position": {
              "basis": "240px",
              "grow": 1,
              "shrink": 0
            },
            "propConfig": {
              "props.params.value": {
                "binding": {
                  "config": {
                    "path": "view.custom.health.coverageDays"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "params": {
                "hint": "Minute history, capped at three months",
                "title": "HISTORY",
                "unit": "days"
              },
              "path": "Demo/Components/Metric"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "Lines"
            },
            "position": {
              "basis": "240px",
              "grow": 1,
              "shrink": 0
            },
            "propConfig": {
              "props.params.value": {
                "binding": {
                  "config": {
                    "path": "view.custom.health.lineCount"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "params": {
                "hint": "Three simulated production lines",
                "title": "LINES",
                "unit": ""
              },
              "path": "Demo/Components/Metric"
            },
            "type": "ia.display.view"
          }
        ],
        "meta": {
          "name": "Metrics"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "Demo/Wrap"
          },
          "wrap": "wrap"
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "Policy"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "Demo/Body"
          },
          "text": "One-second telemetry is retained for 6 hours. Minute history, recorded batch output and inspections are retained for at most 90 days or three calendar months."
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Label"
            },
            "props": {
              "text": "RAMP",
              "textStyle": {
                "color": "#FF0DCF",
                "textAlign": "center"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "SimpleGauge"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.value": {
                "binding": {
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "direct",
                    "tagPath": "[default]Course/Ramp"
                  },
                  "type": "tag"
                }
              }
            },
            "props": {
              "arc": {
                "color": "#79D877"
              },
              "style": {
                "overflow": "hidden"
              }
            },
            "type": "ia.chart.simple-gauge"
          }
        ],
        "meta": {
          "name": "FlexRamp"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "style": {
            "marginTop": 100
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Label"
            },
            "props": {
              "text": "SINE",
              "textStyle": {
                "color": "#FF0DCF"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "SimpleGauge"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.value": {
                "binding": {
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "direct",
                    "tagPath": "[default]Course/Ramp"
                  },
                  "type": "tag"
                }
              }
            },
            "props": {
              "arc": {
                "color": "#D8C377"
              },
              "style": {
                "overflow": "hidden"
              }
            },
            "type": "ia.chart.simple-gauge"
          }
        ],
        "meta": {
          "name": "FlexSine"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "style": {
            "textAlign": "center"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "position": {
      "shrink": 0
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "Demo/Page"
      }
    },
    "type": "ia.container.flex"
  }
}