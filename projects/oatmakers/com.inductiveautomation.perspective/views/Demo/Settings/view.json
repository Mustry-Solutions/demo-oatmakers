{
  "custom": {},
  "params": {},
  "propConfig": {},
  "props": {
    "defaultSize": {
      "width": 1280,
      "height": 1000
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "Demo/Page"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Header"
        },
        "props": {
          "direction": "row",
          "wrap": "wrap",
          "style": {
            "classes": "Demo/PageHeader"
          }
        },
        "children": [
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "Identity"
            },
            "props": {
              "direction": "column"
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "Eyebrow"
                },
                "props": {
                  "text": "OATMAKERS / LIVE OPERATIONS",
                  "style": {
                    "classes": "Demo/Eyebrow"
                  }
                },
                "position": {
                  "shrink": 0,
                  "basis": "auto"
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "Title"
                },
                "props": {
                  "text": "Settings",
                  "style": {
                    "classes": "Demo/PageTitle"
                  }
                },
                "position": {
                  "shrink": 0,
                  "basis": "auto"
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "Subtitle"
                },
                "props": {
                  "text": "Choose how the demo looks for this session.",
                  "style": {
                    "classes": "Demo/Subtitle"
                  }
                },
                "position": {
                  "shrink": 0,
                  "basis": "auto"
                }
              }
            ],
            "position": {
              "shrink": 0,
              "grow": 1
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Mode"
            },
            "props": {
              "text": "SIMULATED FACTORY",
              "style": {
                "classes": "Demo/DemoBadge"
              }
            },
            "position": {
              "shrink": 0,
              "basis": "auto"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if(try({session.custom.theme}, \"\") = \"hello-kitty\", \"HELLO KITTY EDITION\", \"SIMULATED FACTORY\")"
                  }
                }
              }
            }
          }
        ],
        "position": {
          "shrink": 0
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Appearance"
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "Demo/Panel"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "AppearanceTitle"
            },
            "props": {
              "text": "Theme",
              "style": {
                "classes": "Demo/SectionTitle"
              }
            },
            "position": {
              "shrink": 0,
              "basis": "auto"
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "AppearanceSubtitle"
            },
            "props": {
              "text": "Standard follows high-performance HMI practice. Hello Kitty is the pink edition.",
              "style": {
                "classes": "Demo/Muted"
              }
            },
            "position": {
              "shrink": 0,
              "basis": "auto"
            }
          },
          {
            "type": "ia.input.dropdown",
            "meta": {
              "name": "Theme"
            },
            "props": {
              "options": [
                {
                  "value": "standard",
                  "label": "Standard"
                },
                {
                  "value": "hello-kitty",
                  "label": "Hello Kitty"
                }
              ],
              "value": "standard",
              "search": {
                "enabled": false
              },
              "style": {
                "classes": "Demo/Select",
                "overflow": "visible",
                "maxWidth": "320px"
              }
            },
            "position": {
              "shrink": 0,
              "basis": "40px"
            },
            "propConfig": {
              "props.value": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "session.custom.theme",
                    "bidirectional": true
                  }
                }
              }
            }
          }
        ],
        "position": {
          "shrink": 0,
          "grow": 0
        }
      }
    ],
    "position": {
      "shrink": 0
    },
    "propConfig": {
      "props.style.classes": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "if(try({session.custom.theme}, \"\") = \"hello-kitty\", \"Demo/Page Theme/HelloKitty\", \"Demo/Page\")"
          }
        }
      }
    }
  }
}
