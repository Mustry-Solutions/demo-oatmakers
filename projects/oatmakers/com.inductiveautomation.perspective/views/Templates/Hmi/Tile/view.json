{
  "custom": {
    "tile": {
      "title": "",
      "state": "",
      "pillFill": "#dfe3e6",
      "pillText": "#4d555c",
      "rows": []
    }
  },
  "params": {
    "tagPath": "[default]OatMill/Intake/Area",
    "route": "/scada/intake"
  },
  "propConfig": {
    "custom.tile": {
      "binding": {
        "type": "expr-struct",
        "config": {
          "waitOnAll": true,
          "struct": {
            "tick": "now(2000)",
            "path": "{view.params.tagPath}"
          }
        },
        "transforms": [
          {
            "type": "script",
            "code": "\treturn application.demo.scadaTile(value[\"path\"])"
          }
        ]
      },
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.route": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 230,
      "height": 170
    }
  },
