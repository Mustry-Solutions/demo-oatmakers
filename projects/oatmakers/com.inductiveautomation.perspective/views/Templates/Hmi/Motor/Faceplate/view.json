{
  "custom": {
    "current": "",
    "running": "",
    "duty": "",
    "description": "",
    "mode": "",
    "manualRun": "",
    "hours": 1,
    "history": {
      "points": [],
      "unit": "",
      "message": ""
    },
    "edit": {
      "mode": 0
    }
  },
  "params": {
    "tagPath": ""
  },
  "propConfig": {
    "custom.current": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{path}/Current",
          "references": {
            "path": "{view.params.tagPath}"
          },
          "fallbackDelay": 2.5
        }
      },
      "persistent": true
    },
    "custom.running": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{path}/Running",
          "references": {
            "path": "{view.params.tagPath}"
          },
          "fallbackDelay": 2.5
        }
      },
      "persistent": true
    },
    "custom.duty": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{path}/Duty",
          "references": {
            "path": "{view.params.tagPath}"
          },
          "fallbackDelay": 2.5
        }
      },
      "persistent": true
    },
    "custom.description": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{path}/Description",
          "references": {
            "path": "{view.params.tagPath}"
          },
          "fallbackDelay": 2.5
        }
      },
      "persistent": true
    },
    "custom.mode": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{path}/Mode",
          "references": {
            "path": "{view.params.tagPath}"
          },
          "fallbackDelay": 2.5
        }
      },
      "persistent": true,
      "onChange": {
        "enabled": null,
        "script": "\tself.custom.edit.mode = {\"Manual\": 1, \"Off\": 2}.get(currentValue.value, 0)"
      }
    },
    "custom.manualRun": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{path}/ManualRun",
          "references": {
            "path": "{view.params.tagPath}"
          },
          "fallbackDelay": 2.5
        }
      },
      "persistent": true
    },
    "custom.history": {
      "binding": {
        "type": "expr-struct",
        "config": {
          "waitOnAll": true,
          "struct": {
            "path": "{view.params.tagPath}",
            "hours": "{view.custom.hours}",
            "tick": "now(10000)"
          }
        },
        "transforms": [
          {
            "type": "script",
            "code": "\treturn application.demo.faceplateHistory(value[\"path\"], value[\"hours\"])"
          }
        ]
      },
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.hours": {
      "persistent": true
    },
    "custom.edit": {
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 780,
      "height": 700
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "Demo/PopupRoot Hmi/Faceplate"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Header"
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "Hmi/FaceplateHeader"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Name"
            },
            "props": {
              "text": "",
              "style": {
                "classes": "Demo/SectionTitle"
              }
            },
            "position": {
              "shrink": 0,
              "basis": "auto"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "substring({view.params.tagPath}, lastIndexOf({view.params.tagPath}, \"/\") + 1)"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Description"
            },
            "props": {
              "text": "",
              "style": {
                "classes": "Demo/Muted"
              }
            },
            "position": {
              "shrink": 0,
              "basis": "auto"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.custom.description"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Path"
            },
            "props": {
              "text": "",
              "style": {
                "classes": "Hmi/TagPath"
              }
            },
            "position": {
              "shrink": 0,
              "basis": "auto"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.params.tagPath"
                  }
                }
              }
            }
          }
        ],
        "position": {
          "shrink": 0
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Values"
        },
        "props": {
          "direction": "row",
          "style": {
            "classes": "Hmi/FaceplateValues"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Value"
            },
            "props": {
              "text": "",
              "style": {
                "classes": "Hmi/DetailValue"
              }
            },
            "position": {
              "shrink": 0,
              "basis": "auto"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "numberFormat({view.custom.current}, \"#,##0.0\") + \" A\""
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "RunningChip"
            },
            "props": {
              "text": "",
              "style": {
                "classes": "Hmi/Chip"
              }
            },
            "position": {
              "shrink": 0,
              "basis": "auto"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({view.custom.running}, \"RUNNING\", \"STOPPED\")"
                  }
                }
              },
              "props.style.backgroundColor": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({view.custom.running}, \"#2d6a35\", \"#4d555c\")"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "ModeChip"
            },
            "props": {
              "text": "",
              "style": {
                "classes": "Hmi/Chip"
              }
            },
            "position": {
              "shrink": 0,
              "basis": "auto"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "\"MODE \" + upper({view.custom.mode})"
                  }
                }
              },
              "props.style.backgroundColor": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({view.custom.mode} = \"Auto\", \"#4d555c\", \"#6b4a0c\")"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "DutyChip"
            },
            "props": {
              "text": "",
              "style": {
                "classes": "Hmi/Chip"
              }
            },
            "position": {
              "shrink": 0,
              "basis": "auto"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "upper({view.custom.duty})"
                  }
                }
              },
              "props.style.backgroundColor": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "\"#4d555c\""
                  }
                }
              }
            }
          }
        ],
        "position": {
          "shrink": 0
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Settings"
        },
        "props": {
          "direction": "row",
          "style": {
            "classes": "Hmi/FaceplateSettings"
          }
        },
        "children": [
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "ModeField"
            },
            "props": {
              "direction": "column",
              "style": {
                "classes": "Hmi/FieldGroup"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "ModeCaption"
                },
                "props": {
                  "text": "Mode",
                  "style": {
                    "classes": "Demo/Muted"
                  }
                },
                "position": {
                  "shrink": 0,
                  "basis": "auto"
                }
              },
              {
                "type": "ia.input.multi-state-button",
                "meta": {
                  "name": "Mode"
                },
                "props": {
                  "states": [
                    {
                      "text": "Auto",
                      "value": 0,
                      "selectedStyle": {
                        "classes": "",
                        "backgroundColor": "#3f5a73",
                        "color": "#ffffff"
                      },
                      "unselectedStyle": {
                        "classes": "",
                        "backgroundColor": "#eceeef",
                        "color": "#3f4447"
                      }
                    },
                    {
                      "text": "Manual",
                      "value": 1,
                      "selectedStyle": {
                        "classes": "",
                        "backgroundColor": "#3f5a73",
                        "color": "#ffffff"
                      },
                      "unselectedStyle": {
                        "classes": "",
                        "backgroundColor": "#eceeef",
                        "color": "#3f4447"
                      }
                    },
                    {
                      "text": "Off",
                      "value": 2,
                      "selectedStyle": {
                        "classes": "",
                        "backgroundColor": "#3f5a73",
                        "color": "#ffffff"
                      },
                      "unselectedStyle": {
                        "classes": "",
                        "backgroundColor": "#eceeef",
                        "color": "#3f4447"
                      }
                    }
                  ],
                  "orientation": "row",
                  "controlValue": 0,
                  "indicatorValue": 0,
                  "defaultSelectedStyle": {
                    "backgroundColor": "#3f5a73",
                    "color": "#ffffff"
                  },
                  "defaultUnselectedStyle": {
                    "backgroundColor": "#eceeef",
                    "color": "#3f4447"
                  },
                  "style": {
                    "classes": "Hmi/ModeButtons"
                  }
                },
                "position": {
                  "shrink": 0,
                  "basis": "34px"
                },
                "propConfig": {
                  "props.controlValue": {
                    "binding": {
                      "type": "property",
                      "config": {
                        "path": "view.custom.edit.mode",
                        "bidirectional": true
                      }
                    }
                  },
                  "props.indicatorValue": {
                    "binding": {
                      "type": "property",
                      "config": {
                        "path": "this.props.controlValue"
                      }
                    }
                  }
                }
              }
            ],
            "position": {
              "shrink": 0,
              "basis": "190px"
            }
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "Actions"
            },
            "props": {
              "direction": "row",
              "style": {
                "classes": "Hmi/FaceplateActions"
              }
            },
            "children": [
              {
                "type": "ia.input.button",
                "meta": {
                  "name": "Write"
                },
                "props": {
                  "text": "Write",
                  "style": {
                    "classes": "Demo/Button Hmi/ActionButton"
                  }
                },
                "position": {
                  "shrink": 0,
                  "basis": "40px"
                },
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "type": "script",
                      "scope": "G",
                      "config": {
                        "script": "\tedit = self.view.custom.edit\n\tif int(edit.mode) == 1 and self.view.custom.mode != \"Manual\":\n\t\tsystem.tag.writeBlocking([self.view.params.tagPath + \"/ManualRun\"], [bool(self.view.custom.running)])\n\tsystem.tag.writeBlocking([self.view.params.tagPath + \"/Mode\"], [['Auto', 'Manual', 'Off'][int(edit.mode)]])"
                      }
                    }
                  }
                },
                "propConfig": {
                  "props.enabled": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "{view.custom.edit.mode} != case({view.custom.mode}, \"Manual\", 1, \"Off\", 2, 0)"
                      }
                    }
                  }
                }
              },
              {
                "type": "ia.input.button",
                "meta": {
                  "name": "Cancel"
                },
                "props": {
                  "text": "Cancel",
                  "style": {
                    "classes": "Demo/QuietButton Hmi/ActionButton"
                  }
                },
                "position": {
                  "shrink": 0,
                  "basis": "40px"
                },
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "type": "script",
                      "scope": "G",
                      "config": {
                        "script": "\tc = self.view.custom\n\tc.edit.mode = 1 if c.mode == \"Manual\" else (2 if c.mode == \"Off\" else 0)\n"
                      }
                    }
                  }
                },
                "propConfig": {
                  "props.enabled": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "{view.custom.edit.mode} != case({view.custom.mode}, \"Manual\", 1, \"Off\", 2, 0)"
                      }
                    }
                  }
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "Pending"
                },
                "props": {
                  "text": "",
                  "style": {
                    "classes": "Demo/Muted"
                  }
                },
                "position": {
                  "shrink": 0,
                  "basis": "auto"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "if({view.custom.edit.mode} != case({view.custom.mode}, \"Manual\", 1, \"Off\", 2, 0), \"Changes not written yet\", \"\")"
                      }
                    }
                  }
                }
              }
            ],
            "position": {
              "shrink": 0
            }
          }
        ],
        "position": {
          "shrink": 0
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Commands"
        },
        "props": {
          "direction": "row",
          "style": {
            "classes": "Hmi/FaceplateRanges"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "CommandsCaption"
            },
            "props": {
              "text": "Manual control",
              "style": {
                "classes": "Demo/Muted"
              }
            },
            "position": {
              "shrink": 0,
              "basis": "auto"
            }
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "Start"
            },
            "props": {
              "text": "Start",
              "style": {
                "classes": "Demo/QuietButton Hmi/ActionButton"
              }
            },
            "position": {
              "shrink": 0,
              "basis": "40px"
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tsystem.tag.writeBlocking([self.view.params.tagPath + \"/ManualRun\"], [True])"
                  }
                }
              }
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{view.custom.mode} = \"Manual\""
                  }
                }
              },
              "props.style.classes": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({view.custom.manualRun} = true && {view.custom.mode} = \"Manual\", \"Demo/QuietButton Hmi/ActionButton Hmi/RangeActive\", \"Demo/QuietButton Hmi/ActionButton\")"
                  }
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "Stop"
            },
            "props": {
              "text": "Stop",
              "style": {
                "classes": "Demo/QuietButton Hmi/ActionButton"
              }
            },
            "position": {
              "shrink": 0,
              "basis": "40px"
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tsystem.tag.writeBlocking([self.view.params.tagPath + \"/ManualRun\"], [False])"
                  }
                }
              }
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{view.custom.mode} = \"Manual\""
                  }
                }
              },
              "props.style.classes": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({view.custom.manualRun} = false && {view.custom.mode} = \"Manual\", \"Demo/QuietButton Hmi/ActionButton Hmi/RangeActive\", \"Demo/QuietButton Hmi/ActionButton\")"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "ManualHint"
            },
            "props": {
              "text": "",
              "style": {
                "classes": "Demo/Muted"
              }
            },
            "position": {
              "shrink": 0,
              "basis": "auto"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({view.custom.mode} = \"Manual\", \"Commands act immediately.\", \"Write Mode Manual to enable the commands.\")"
                  }
                }
              }
            }
          }
        ],
        "position": {
          "shrink": 0
        }
      },
