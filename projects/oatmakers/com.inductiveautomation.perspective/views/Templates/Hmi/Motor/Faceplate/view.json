          {
            "type": "ia.input.button",
            "meta": {
              "name": "Range8h"
            },
            "props": {
              "text": "8 h",
              "style": {
                "classes": "Demo/QuietButton Hmi/RangeButton"
              }
            },
            "position": {
              "shrink": 0,
