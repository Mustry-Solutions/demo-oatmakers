            "props": {
              "text": "24 h",
              "style": {
                "classes": "Demo/QuietButton Hmi/RangeButton"
              }
            },
            "position": {
              "shrink": 0,
              "basis": "40px"
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tself.view.custom.hours = 24"
                  }
                }
              }
            },
            "propConfig": {
              "props.style.classes": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({view.custom.hours} = 24, \"Demo/QuietButton Hmi/RangeButton Hmi/RangeActive\", \"Demo/QuietButton Hmi/RangeButton\")"
                  }
                }
              }
            }
          }
        ],
        "position": {
          "shrink": 0
        }
      },
      {
        "type": "ia.chart.xy",
        "meta": {
          "name": "History"
