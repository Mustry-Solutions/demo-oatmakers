{
  "custom": {
    "running": false,
    "mode": "Auto"
  },
  "params": {
    "tagPath": "[default]OatMill/Intake/M-CV101"
  },
  "propConfig": {
    "custom.running": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{path}/Running",
          "references": {
            "path": "{view.params.tagPath}"
          },
          "fallbackDelay": 2.5
        }
      },
      "persistent": true
    },
    "custom.mode": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{path}/Mode",
          "references": {
            "path": "{view.params.tagPath}"
          },
          "fallbackDelay": 2.5
        }
      },
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 110,
      "height": 60
    }
  },
  "root": {
    "type": "ia.container.coord",
    "meta": {
      "name": "root"
    },
    "props": {
      "mode": "fixed",
      "style": {
        "cursor": "pointer"
      }
    },
    "children": [
      {
        "type": "ia.shapes.svg",
        "meta": {
          "name": "Shape"
        },
        "props": {
          "viewBox": "0 0 110 60",
          "preserveAspectRatio": "none",
          "elements": [
            {
              "type": "group",
              "name": "g0",
              "fill": {
                "paint": "#555"
              },
              "elements": [
                {
                  "type": "circle",
                  "name": "circle0",
                  "cx": "20",
                  "cy": "30",
                  "r": "14",
                  "fill": {
                    "paint": "#a7dfa5"
                  },
                  "stroke": {
                    "paint": "#555",
                    "width": "1.6"
                  }
                },
                {
                  "type": "path",
                  "name": "path1",
                  "d": "M6 30 h28 M20 16 v28 M10 20 l20 20 M30 20 l-20 20",
                  "stroke": {
                    "paint": "#555",
                    "width": "1"
                  }
                }
              ]
            }
          ],
          "style": {
            "pointerEvents": "none",
            "overflow": "visible"
          }
        },
        "position": {
          "x": 0,
          "y": 0,
          "width": 110,
          "height": 60
        },
        "propConfig": {
          "props.elements[0].elements[0].fill.paint": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.custom.running}, \"#a7dfa5\", \"#b3b3b3\")"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Tag"
        },
        "props": {
          "text": "",
          "style": {
            "classes": "Hmi/Tag",
            "alignItems": "flex-start"
          }
        },
        "position": {
          "x": 42,
          "y": 22,
          "width": 68,
          "height": 15
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "substring({view.params.tagPath}, lastIndexOf({view.params.tagPath}, \"/\") + 1)"
              }
            }
          },
          "meta.visible": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{session.custom.showLabels}"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Mode"
        },
        "props": {
          "text": "",
          "style": {
            "classes": "Hmi/Shape",
            "fontSize": "8px",
            "fontWeight": 700,
            "color": "#ffffff",
            "alignItems": "center",
            "backgroundColor": "#6b4a0c",
            "borderRadius": "2px"
          }
        },
        "position": {
          "x": 2,
          "y": 2,
          "width": 28,
          "height": 12
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.custom.mode} = \"Off\", \"OFF\", \"MAN\")"
              }
            }
          },
          "meta.visible": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.custom.mode} != \"Auto\" && len({view.custom.mode}) > 0"
              }
            }
          }
        }
      }
    ],
    "position": {
      "shrink": 0
    },
    "events": {
      "dom": {
        "onClick": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "\tapplication.demo.openFaceplate(\"Motor\", self.view.params.tagPath)"
          }
        }
      }
    }
  }
}
