# Local settings for this clone. Copy to .env (gitignored); scripts/setup.sh
# does that for you on its first run:
#
#     cp .env.example .env
#
# Lab 07 Part 0 (your personal test gateway and runner) starts when LAB_USER is
# set. Run ./scripts/setup.sh after filling it in: on the first run it seeds
# your API token into the test gateway before that gateway boots.

# ---------------------------------------------------------------------------
# Your name: lowercase, no spaces. Everything for Part 0 derives from it:
#   your runner's label      ->  <yourname>-local
#   your runner's name       ->  oatmakers-test-<yourname>
#   your runner container    ->  oatmakers-test-runner-<yourname>
#   your workflow's runs-on  ->  [self-hosted, <yourname>-local]
# Leave it at yourname (or empty) to run only the local gateway and database.
# ---------------------------------------------------------------------------
LAB_USER=yourname

# ---------------------------------------------------------------------------
# This clone's scan-API key. Leave EMPTY: scripts/setup.sh generates
# `CICD-APIKEY:<secret>` here on its first run and writes the matching
# hash-only token resource for your local and test gateways. Compose passes it
# into your test runner, so your test workflow needs no GitHub secret. (The
# repository's IGNITION_API_KEY Actions secret is production's key.)
# To rotate it: empty the value and run scripts/setup.sh again.
# ---------------------------------------------------------------------------
IGNITION_API_KEY=

# ---------------------------------------------------------------------------
# Registering a runner on the shared repo needs repo-admin rights, which
# contributors do not have, so the credential comes from the instructors.
#
#   RUNNER_TOKEN       the registration token posted in the chat at the start
#                      of Part 0. Valid one hour, it can only enroll runners,
#                      and it only has to work once: the registration persists
#                      in a volume.
#   RUNNER_GITHUB_PAT  instructor-only fallback for unattended machines. It
#                      carries repo-admin rights, so it is never handed out.
# ---------------------------------------------------------------------------
RUNNER_TOKEN=
RUNNER_GITHUB_PAT=

# ---------------------------------------------------------------------------
# Overrides: only uncomment when you have a reason.
# ---------------------------------------------------------------------------
# Host ports, when something else already listens on 8088 / 8090 / 5432.
#GATEWAY_PORT=8088
#TEST_GATEWAY_PORT=8090
#POSTGRES_PORT=5432

# Your runner's second label. Your test-<yourname>.yml's runs-on must match it.
#RUNNER_LABEL=yourname-local

# The runner's registered name.
#RUNNER_NAME=oatmakers-test-yourname

# The repository the runner registers on.
#REPO_URL=https://github.com/Mustry-Solutions/demo-oatmakers

# A second copy of this stack on the same machine (an instructor running two
# students side by side): every container name starts with this instead of
# `oatmakers`. Give that copy its own ports above as well.
#COMPOSE_PROJECT_NAME=oatmakers
